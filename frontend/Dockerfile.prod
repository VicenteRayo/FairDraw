# Production image: a static build served by nginx, meant to run behind a reverse proxy at a
# configurable subpath (see ../docker-compose.prod.yml and WebVicente's nginx.conf, which proxies
# /proyectos/fairdraw/ to this container with the prefix already stripped — so this container's own
# nginx just serves dist/ at "/", unaware of the public subpath).
#
# For local development, use the plain Dockerfile (Vite dev server) instead — this one is not meant
# to be used with docker-compose.yml.

FROM node:22-alpine AS build
WORKDIR /app

# Baked into the JS bundle at build time (Vite env vars are compile-time, not runtime), so both
# must be provided as build args. Defaults match local/standalone usage (no subpath, absolute API URL).
ARG VITE_BASE_PATH=/
ARG VITE_API_BASE_URL=http://localhost:5080/api/v1
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}

COPY package.json package-lock.json* ./
RUN npm install

COPY . .
RUN npm run build -- --base=${VITE_BASE_PATH}

FROM nginx:alpine AS runtime
COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.prod.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
