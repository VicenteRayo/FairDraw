<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.12" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\FairDraw.Api\FairDraw.Api.csproj" />
    <ProjectReference Include="..\..\src\FairDraw.Infrastructure\FairDraw.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\FairDraw.Domain\FairDraw.Domain.csproj" />
    <ProjectReference Include="..\..\src\FairDraw.Crypto\FairDraw.Crypto.csproj" />
    <ProjectReference Include="..\FairDraw.UnitTests\FairDraw.UnitTests.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Same shared golden vectors as FairDraw.UnitTests, needed here because GoldenVectors.Load()
         reads from AppContext.BaseDirectory of whichever test host is actually running. -->
    <Content Include="..\..\..\test-vectors\canonical-vectors.json" Link="canonical-vectors.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>